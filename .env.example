# Yandex Tracker MCP integration (SPEC-013) — placeholders only, never real
# secrets. Copy to `.env` at the project root (git-ignored) and app.py will
# load it automatically via a small dependency-free loader
# (`app.py::load_dotenv_if_present`) — no `python-dotenv` package required.
# Anything already exported in your real shell environment always wins over
# a value from this file.
#
# Disabled by default: a fresh checkout never needs any of this.
TRACKER_MCP_ENABLED=false
TRACKER_TOKEN=
# Exactly one of the next two, never both:
TRACKER_ORG_ID=
TRACKER_CLOUD_ORG_ID=

# Safe fixtures for the opt-in live smoke suite
# (python -m evals.runner --suite live --category tracker). Must point at a
# real, but low-stakes, issue/queue/query in your own Tracker instance —
# never invent or commit real identifiers here.
TRACKER_SMOKE_ISSUE_ID=
TRACKER_SMOKE_QUEUE_ID=
TRACKER_SMOKE_SEARCH_QUERY=
