# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example

# Experiment artifacts
*.log
logs/
outputs/
runs/
data/*.json
models/
*.gguf

# Generated runtime SQLite database (rebuild with scripts/init_database.py).
# The seed script under data/seed/ stays tracked.
data/chinook.sqlite
data/.chinook.sqlite.*.tmp

# Structured agent traces and evaluation results (SPEC-011): generated,
# local-only, and never uploaded. `evals/` (the committed case definitions
# and runner) is a different, tracked top-level directory and is unaffected.
data/traces/
data/evals/

# MCP child process logging (PATCH-009-01): each server's own stderr, one file
# per run, kept off the terminal but on disk so a failing child can still be
# diagnosed. Generated, local-only, never uploaded.
data/mcp/

# Per-job sandbox scratch space (SPEC-015): read-only source/input mounts and
# the collected output copy. Every job directory is deleted after its result is
# built, so nothing here should survive a run — no generated artifact, source
# copy, input copy, or container id belongs in git. The committed sandbox image
# definition (`sandbox/`) and the runtime package (`sandbox_runtime/`) are
# different, tracked directories and are unaffected.
data/sandbox/

# Per-turn sandbox artifacts (SPEC-016): files a successful turn produced for
# the user. They deliberately outlive their turn so the user can open them, but
# they are generated output belonging to one local run — never part of the
# experiment's source. A failed turn's directory is removed at the turn
# boundary; these are the ones that survived.
data/artifacts/

# OS / editor
.DS_Store
.idea/
.vscode/
