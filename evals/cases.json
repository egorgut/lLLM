            826.65
          ]
        ],
        "row_count": 1,
        "truncated": false
      },
      "python_calculate": {
        "ok": true,
        "result": 35.5
      }
    },
    "expectation": {
      "expected_selection": "sales_analysis",
      "selection_source": "model",
      "status": "completed",
      "required_tools": [
        "sql_query",
        "python_calculate"
      ],
